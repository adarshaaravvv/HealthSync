# Demo host with a Groq key. Used to check routing without a real key:
#   uvicorn app.main:app --env-file .env.groq --port 8002
HEALTHSYNC_DEMO_MODE=true
HEALTHSYNC_GROQ_API_KEY=gsk_not_a_real_key_for_routing_checks
HEALTHSYNC_ASR_DEVICE=cpu
HEALTHSYNC_ASR_COMPUTE=int8
HEALTHSYNC_ASR_MODEL=tiny
HEALTHSYNC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
